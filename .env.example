# ============================================================== OpenRouter
# One key, many upstream models, OpenAI-compatible. This is the provider the
# committed results were produced with; free tiers elsewhere (Groq 200k
# tokens/day, Gemini 20 requests/day) are too small for a full ingest plus a
# two-preset judged evaluation.
#
#   OPENROUTER_API_KEY=sk-or-v1-...
#   FERMI_LLM_PROVIDER=openrouter
#   FERMI_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
#   FERMI_EMBED_PROVIDER=local      # no key needed, runs on CPU
#   FERMI_ASR_PROVIDER=groq         # or `local` for faster-whisper, no key

# ============================================================== API keys
# You need exactly ONE chat provider. Pick a row and fill it in.
#
#   Gemini     GEMINI_API_KEY      + FERMI_LLM_PROVIDER=gemini
#   Anthropic  ANTHROPIC_API_KEY   + FERMI_LLM_PROVIDER=anthropic
#   OpenAI     OPENAI_API_KEY      + FERMI_LLM_PROVIDER=openai
#   Groq       GROQ_API_KEY        + FERMI_LLM_PROVIDER=groq
#
# Transcription needs no key at all with FERMI_ASR_PROVIDER=local.

# GEMINI_API_KEY=            # GOOGLE_API_KEY also accepted
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=              # needed only if FERMI_ASR_PROVIDER=groq

# ============================================================ providers
# LLM for routing / answering / judging:
#   anthropic | openai | gemini | groq | stub
FERMI_LLM_PROVIDER=anthropic

# Embeddings: gemini | openai | local | none
#   gemini -> gemini-embedding-001, asymmetric retrieval task types
#   openai -> text-embedding-3-small
#   local  -> sentence-transformers, free, needs the optional dependency
#   none   -> BM25-only retrieval; works, but weaker on paraphrased questions
FERMI_EMBED_PROVIDER=openai

# Transcription: local (faster-whisper, free, precise timestamps)
#              | groq  (hosted whisper-large-v3-turbo, minutes not hours)
FERMI_ASR_PROVIDER=local

# ---- ALL-GEMINI SETUP: uncomment these three, comment the defaults above
# FERMI_LLM_PROVIDER=gemini
# FERMI_EMBED_PROVIDER=gemini
# FERMI_ASR_PROVIDER=local

# =========================================================== model names
# Override if a provider renames a model.
# FERMI_GEMINI_MODEL=gemini-2.5-flash
# FERMI_GEMINI_EMBED_MODEL=gemini-embedding-001
# FERMI_GEMINI_EMBED_DIM=768
# FERMI_ANTHROPIC_MODEL=claude-sonnet-5
# FERMI_OPENAI_MODEL=gpt-4o-mini
# FERMI_OPENAI_EMBED_MODEL=text-embedding-3-small
# FERMI_GROQ_MODEL=llama-3.3-70b-versatile

# ====================================================== local ASR tuning
# medium.en is the quality/speed sweet spot on CPU. small.en is ~3x faster.
# FERMI_WHISPER_MODEL=medium.en
# FERMI_WHISPER_DEVICE=cpu        # set to cuda if you have an NVIDIA GPU
# FERMI_WHISPER_COMPUTE=int8      # float16 on GPU

# ==================================================== rate-limit behaviour
# All provider calls retry on 429 with the server-advertised delay when one
# is given, else exponential backoff. On a tight free tier you can also pace
# calls proactively, which is cheaper than burning retries:
#   FERMI_MIN_CALL_INTERVAL_S=13   # ~5 requests/min (Gemini free tier)
#   FERMI_RETRY_ATTEMPTS=6
